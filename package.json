{
  "name": "Achievements",
  "version": "1.2.3-beta",
  "description": "Achievements",
  "author": "JokerVerse",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dl-browsers": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 node ./node_modules/playwright-core/cli.js install chromium chromium-headless-shell",
    "dist-linux": "npm run dl-browsers && electron-builder -l --x64",
    "dist-windows": "npm run dl-browsers && electron-builder -w --x64"
  },
  "dependencies": {
    "axios": "^1.12.0",
    "cheerio": "^1.1.2",
    "chokidar": "5.0.0",
    "crc-32": "^1.2.2",
    "electron-updater": "^6.8.3",
    "ini": "6.0.0",
    "jsdom": "29.1.1",
    "koffi": "3.1.0",
    "playwright": "^1.55.0",
    "playwright-extra": "^4.3.6",
    "ps-list": "9.0.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "screenshot-desktop": "^1.15.3",
    "uiohook-napi": "1.5.5",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "electron": "43.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.1",
    "rcedit": "^5.0.2"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "temp": {
      "rimraf": "^5.0.10"
    },
    "glob": {
      "minimatch": ">=10.2.1"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@43.1.0": true,
    "koffi@3.1.0": true,
    "uiohook-napi@1.5.5": true
  }
}